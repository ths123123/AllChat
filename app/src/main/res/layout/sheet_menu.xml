<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp"
    android:paddingBottom="16dp">

    <TextView
        android:id="@+id/sheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="24dp"
        android:paddingTop="8dp"
        android:paddingEnd="24dp"
        android:paddingBottom="8dp"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <TextView android:id="@+id/rowReload" style="@style/SheetRow" android:text="Muat ulang" />
    <TextView android:id="@+id/rowOpenApp" style="@style/SheetRow" android:text="Buka aplikasi asli" />
    <TextView android:id="@+id/rowUpdate" style="@style/SheetRow" android:text="Cek pembaruan" />
    <TextView
        android:id="@+id/rowDisconnect"
        style="@style/SheetRow"
        android:text="Keluar dari akun ini"
        android:textColor="#E5484D" />
</LinearLayout>
