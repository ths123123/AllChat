<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/pager"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:visibility="invisible"
            app:trackColor="@android:color/transparent"
            app:trackThickness="2dp" />
    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1px"
        android:background="@color/hairline" />

    <!-- Bar bawah ramping: 2 tab + tombol menu -->
    <LinearLayout
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/bar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="4dp">

        <LinearLayout
            android:id="@+id/tabMessenger"
            style="@style/BarTab">

            <ImageView
                android:id="@+id/iconMessenger"
                style="@style/BarTabIcon"
                android:src="@drawable/ic_messenger" />

            <TextView
                android:id="@+id/labelMessenger"
                style="@style/BarTabLabel"
                android:text="Messenger" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabInstagram"
            style="@style/BarTab">

            <ImageView
                android:id="@+id/iconInstagram"
                style="@style/BarTabIcon"
                android:src="@drawable/ic_instagram" />

            <TextView
                android:id="@+id/labelInstagram"
                style="@style/BarTabLabel"
                android:text="Instagram" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/moreButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Menu"
            android:src="@drawable/ic_more"
            app:tint="@color/muted" />
    </LinearLayout>
</LinearLayout>
